{
  "name": "@dotgui/cli",
  "version": "0.2.0",
  "description": "The dotgui toolchain — read, edit, lint, render, and package .gui files. No AI; installs the dotgui skill into your agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gui": "./dist/cli.js",
    "dotgui": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --minify",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotgui/kit": "^0.1.0",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["dotgui", "gui", "cli", "design", "ui"],
  "repository": {
    "type": "git",
    "url": "https://github.com/dotgui/cli"
  }
}
